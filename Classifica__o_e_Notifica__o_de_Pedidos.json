        "mode": "runOnceForEachItem",
        "jsCode": "const labels = $input.item.json.labels;\nconst scores = $input.item.json.scores;\nconst sequence = $input.item.json.sequence;\n\nlet maxIndex = 0;\nfor (let i = 1; i < scores.length; i++) {\n  if (scores[i] > scores[maxIndex]) maxIndex = i;\n}\n\nreturn {\n  json: {\n    Descrição: sequence,\n    Categoria: labels[maxIndex]\n  }\n};"
