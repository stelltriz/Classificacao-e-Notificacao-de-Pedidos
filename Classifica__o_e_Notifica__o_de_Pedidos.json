      "parameters": {
        "jsCode": "const assistenteTI = [];\n\nfor (const item of $input.all()) {\n  const { Nome, Descrição, NívelDeUrgência } = item.json;\n  const linha = `- ${Nome}: ${Descrição} (Urgência: ${NívelDeUrgência})`;\n  assistenteTI.push(linha);\n}\n\nreturn [\n  {\n    json: {\n      corpo: assistenteTI.join(\"\\n\"),\n    },\n  },\n];\n"
      },
